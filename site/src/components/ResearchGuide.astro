---
import GuideSection from './GuideSection.astro';

const contents = [
	['start', 'Start a project'],
	['sources', 'Find evidence'],
	['data', 'Work with data'],
	['article', 'Write the article'],
	['publish', 'Prepare to publish'],
];

const sources = [
	{
		name: 'PubMed',
		type: 'Biomedical literature database',
		description: 'Search biomedical and life-sciences citations. Check each record’s article type, journal, and full-text links; inclusion in PubMed is not itself a guarantee of quality.',
		url: 'https://pubmed.ncbi.nlm.nih.gov/',
	},
	{
		name: 'Nature',
		type: 'Research journals and science news',
		description: 'Explore research papers and reviews. Check the article type and methods: a respected journal does not make an individual finding definitive.',
		url: 'https://www.nature.com/',
	},
	{
		name: 'NHS',
		type: 'Evidence-informed health information',
		description: 'Useful for accessible clinical and public-health context. NHS pages are health guidance, not primary research papers or individual medical advice.',
		url: 'https://www.nhs.uk/conditions/',
	},
];

const datasets = [
	{
		name: 'NCBI Gene Expression Omnibus',
		url: 'https://www.ncbi.nlm.nih.gov/geo/',
		description: 'Public functional-genomics data, including expression studies. Read the study design, sample annotations, and reuse terms.',
	},
	{
		name: 'PhysioNet',
		url: 'https://physionet.org/',
		description: 'Physiological signals and clinical data. Some datasets require credentialing, training, or an approved data-use agreement.',
	},
	{
		name: 'ClinicalTrials.gov',
		url: 'https://clinicaltrials.gov/',
		description: 'Find registered studies and posted results. Registration is useful context, but is not the same as peer review or a published paper.',
	},
];
---

<a class="skip-link" href="#main-content">Skip to main content</a>
<header class="site-header" id="top">
	<a class="wordmark" href="#top" aria-label="Beginner Guide to Research, home">
		<span class="brand-mark" aria-hidden="true">BG</span>
		<span>Fieldnotes <span class="brand-divider">/</span> Bioscience</span>
	</a>
	<nav aria-label="Main navigation">
		<a href="#start">Start</a>
		<a href="#sources">Sources</a>
		<a href="#data">Data</a>
		<a href="#article">Writing</a>
		<a href="#publish">Publishing</a>
		<a href="#contact">Contact</a>
	</nav>
</header>

<main id="main-content" tabindex="-1">
	<section class="hero" aria-labelledby="page-title">
		<div class="hero-copy">
			<p class="eyebrow"><span></span>A field guide for curious minds</p>
			<h1 id="page-title">Beginner guide<br />to <em>research.</em></h1>
			<p class="hero-intro">A clear path from your first question to a well-written paper. For students and early-career researchers in biology and medical sciences.</p>
			<a class="hero-link" href="#start">Explore the guide <span aria-hidden="true">↓</span></a>
			<p class="hero-note">Curiosity first. Evidence always.</p>
		</div>
		<figure class="hero-visual">
			<img src="https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&w=1100&q=85" alt="A biomedical researcher working with laboratory equipment" fetchpriority="high" />
			<figcaption><span>OBSERVE</span><span>QUESTION</span><span>INVESTIGATE</span></figcaption>
			<span class="hero-index" aria-hidden="true">FIELD GUIDE 01—05</span>
		</figure>
	</section>

	<div class="guide-layout">
		<aside class="contents" aria-label="Guide contents">
			<p class="contents-heading">In this guide</p>
			<ol>
				{contents.map(([id, label], index) => (
					<li><a href={`#${id}`}><span>0{index + 1}</span>{label}</a></li>
				))}
			</ol>
			<div class="contents-note"><span aria-hidden="true">i</span><p>Learning resource only. Not medical advice.</p></div>
		</aside>

		<div class="guide-content">
			<GuideSection id="start" number="01" kicker="Begin with a question" title="Start small. Think clearly.">
				<p class="section-lead">Research is a structured way to answer a question using evidence. You do not need a breakthrough idea to begin; you need a focused question, a feasible plan, and honest methods.</p>
				<div class="steps-grid">
					<article><span>A</span><h3>Choose a topic</h3><p>Start with a subject that interests you. Read an introductory review, then note what is known and what remains uncertain.</p></article>
					<article><span>B</span><h3>Make it answerable</h3><p>Define the population or system, exposure or intervention, comparison, and outcome. For clinical questions, PICO can help focus the scope.</p></article>
					<article><span>C</span><h3>Plan before collecting</h3><p>Choose a design that fits the question, define measures and analysis in advance, and ask a supervisor or statistician about feasibility and sample size.</p></article>
				</div>
				<aside class="ethics-callout"><strong>Before involving people, samples, or identifiable records</strong><p>Check with your institution’s research ethics committee and data-protection lead before starting. Approval, consent, and governance requirements depend on the study and location.</p></aside>
			</GuideSection>

			<GuideSection id="sources" number="02" kicker="Read beyond the abstract" title="Find evidence you can trust.">
				<p class="section-lead">A search result is a starting point, not an endorsement. Trace claims to the original study, check how it was done, and compare it with the wider evidence.</p>
				<div class="source-list">
					{sources.map((source, index) => (
						<article class="source-row">
							<span class="row-index">0{index + 1}</span>
							<div><p class="source-type">{source.type}</p><h3><a href={source.url} target="_blank" rel="noreferrer">{source.name}<span aria-label=" (opens in a new tab)"> ↗</span></a></h3><p>{source.description}</p></div>
						</article>
					))}
				</div>
				<div class="evidence-panel">
					<h3>Five checks for a paper</h3>
					<ul>
						<li><strong>Study type:</strong> original research, review, systematic review, or commentary?</li>
						<li><strong>Methods:</strong> are the design, sample, measures, and analysis clear?</li>
						<li><strong>Limits:</strong> do the authors discuss bias, uncertainty, and limitations?</li>
						<li><strong>Context:</strong> do independent studies support or challenge the finding?</li>
						<li><strong>Journal:</strong> can you verify its editorial process, peer review, and policies?</li>
					</ul>
					<p class="caution">Peer review is an important quality check, not proof that a result is correct. A database, journal name, or professional-looking website alone is not enough.</p>
				</div>
				<figure class="research-image">
					<img src="https://images.unsplash.com/photo-1579154204601-01588f351e67?auto=format&fit=crop&w=1000&q=80" alt="A scientist examining a specimen through a microscope" loading="lazy" />
					<figcaption>Research begins with careful observation.</figcaption>
				</figure>
			</GuideSection>

			<GuideSection id="data" number="03" kicker="Use data responsibly" title="Practise with the right dataset.">
				<p class="section-lead">Public datasets are useful for learning, but “public” does not mean unrestricted. Read the documentation, licensing, access rules, and original publication before reusing data.</p>
				<div class="dataset-list">
					{datasets.map((dataset, index) => (
						<article class="dataset-row"><span class="row-index">0{index + 1}</span><div><h3><a href={dataset.url} target="_blank" rel="noreferrer">{dataset.name}<span aria-label=" (opens in a new tab)"> ↗</span></a></h3><p>{dataset.description}</p></div></article>
					))}
				</div>
				<div class="data-callout"><div><span aria-hidden="true">!</span><h3>Medical data needs extra care</h3></div><p>Health and genomic data can be sensitive, even when names have been removed. Use only data you are authorized to access; follow consent conditions, data-use agreements, security requirements, and local law. Never try to identify participants.</p></div>
				<div class="workflow" aria-label="A simple data workflow"><span>Read the codebook</span><span aria-hidden="true">→</span><span>Check variables and missingness</span><span aria-hidden="true">→</span><span>Record each decision</span></div>
			</GuideSection>

			<GuideSection id="article" number="04" kicker="Turn a study into a paper" title="Write so others can follow.">
				<p class="section-lead">Many original research articles use an IMRaD structure. Follow the target journal’s author instructions and reporting guideline; different study types may need different sections.</p>
				<div class="imrad-list">
					<article><span>I</span><div><h3>Introduction <small>Why was this study needed?</small></h3><p>Set the context, summarize relevant evidence, identify the specific gap, then state the research question, aim, and hypothesis if appropriate.</p><em>Move from broad context to the precise question.</em></div></article>
					<article><span>M</span><div><h3>Methods <small>What did you do?</small></h3><p>Describe the design, setting, participants or samples, eligibility criteria, measures, procedures, ethics approval, and statistical analysis with enough detail to assess or reproduce the work.</p><em>Report what was actually done, including changes from the plan.</em></div></article>
					<article><span>R</span><div><h3>Results <small>What did you find?</small></h3><p>Report sample flow, primary findings, and relevant estimates with uncertainty. Use tables and figures to clarify; do not repeat every value in the text.</p><em>Keep interpretation for the Discussion.</em></div></article>
					<article><span>D</span><div><h3>Discussion <small>What do the findings mean?</small></h3><p>Summarize the main result, compare it with prior work, discuss strengths and limitations, and state implications without overstating causality or certainty.</p><em>End with a proportionate conclusion, not a new claim.</em></div></article>
					<article><span>R</span><div><h3>References <small>Where did the evidence come from?</small></h3><p>Cite sources for other people’s ideas, methods, data, or words. Use the required style consistently and verify authors, title, journal, year, and DOI.</p><em>Use a reference manager, then check every citation against its source.</em></div></article>
				</div>
				<figure class="writing-image">
					<img src="https://images.unsplash.com/photo-1455390582262-044cdead277a?auto=format&fit=crop&w=1000&q=80" alt="A person writing notes at a desk" loading="lazy" />
					<figcaption>Draft, revise, verify: clear writing is part of clear research.</figcaption>
				</figure>
				<aside class="writing-note"><strong>A practical drafting order</strong><p>After the study is complete, many authors draft Methods and Results first, then Introduction and Discussion, and write the title and abstract last. Check the journal’s required format.</p></aside>
			</GuideSection>

			<GuideSection id="publish" number="05" kicker="Share work with care" title="Prepare for publication.">
				<p class="section-lead">Publishing is a process of transparent reporting and review. A rejection or request for revision is common; it is not, by itself, a verdict on your potential as a researcher.</p>
				<ol class="publish-steps">
					<li><span>1</span><div><h3>Choose a suitable journal</h3><p>Check the journal’s scope, recent articles, readership, indexing, peer-review process, fees, and publication policies.</p></div></li>
					<li><span>2</span><div><h3>Follow the instructions</h3><p>Use the required structure, word limits, reference style, figures, declarations, and reporting checklist. EQUATOR helps identify guidelines such as CONSORT, STROBE, and PRISMA.</p></div></li>
					<li><span>3</span><div><h3>Complete ethics and disclosures</h3><p>Include ethics approval or exemption, consent where applicable, funding, conflicts of interest, author contributions, and data availability statements.</p></div></li>
					<li><span>4</span><div><h3>Submit and respond carefully</h3><p>Send the manuscript and a concise cover letter. Address reviewer comments point by point, explain changes, and keep a respectful record of the response.</p></div></li>
				</ol>
				<div class="guideline-band"><div><p class="source-type">REPORTING GUIDELINES</p><h3>Make the study easier to assess.</h3><p>Use a guideline that matches your study design.</p></div><a href="https://www.equator-network.org/" target="_blank" rel="noreferrer">Explore EQUATOR Network <span aria-label=" (opens in a new tab)">↗</span></a></div>
			</GuideSection>

			<section class="contact" id="contact" aria-labelledby="contact-title">
				<p class="section-kicker">Contact info</p>
				<h2 id="contact-title">Let’s connect.</h2>
				<div class="contact-panel">
					<div class="contact-copy">
						<p>For collaborations, feedback, or questions about research methods, I’m happy to hear from you.</p>
					</div>
					<ul class="contact-list">
						<li><span>Email</span><a href="mailto:hello@fieldnotes.bio">hello@fieldnotes.bio</a></li>
						<li><span>LinkedIn</span><a href="https://www.linkedin.com/" target="_blank" rel="noreferrer">linkedin.com/in/fieldnotes</a></li>
						<li><span>GitHub</span><a href="https://github.com/" target="_blank" rel="noreferrer">github.com/fieldnotes</a></li>
					</ul>
				</div>
			</section>

			<section class="references" aria-labelledby="references-title">
				<p class="section-kicker">Keep learning</p>
				<h2 id="references-title">Reliable places to begin.</h2>
				<p class="references-intro">These organizations offer databases, reporting standards, or publication guidance. Check the exact article or policy relevant to your project.</p>
				<ul>
					<li><a href="https://www.icmje.org/recommendations/" target="_blank" rel="noreferrer">ICMJE: Recommendations for the Conduct, Reporting, Editing, and Publication of Scholarly Work <span aria-label=" (opens in a new tab)">↗</span></a></li>
					<li><a href="https://www.equator-network.org/" target="_blank" rel="noreferrer">EQUATOR Network: reporting guidelines <span aria-label=" (opens in a new tab)">↗</span></a></li>
					<li><a href="https://www.ncbi.nlm.nih.gov/geo/" target="_blank" rel="noreferrer">NCBI Gene Expression Omnibus (GEO) <span aria-label=" (opens in a new tab)">↗</span></a></li>
					<li><a href="https://physionet.org/" target="_blank" rel="noreferrer">PhysioNet: clinical and physiological data <span aria-label=" (opens in a new tab)">↗</span></a></li>
					<li><a href="https://www.nhs.uk/" target="_blank" rel="noreferrer">NHS: health information <span aria-label=" (opens in a new tab)">↗</span></a></li>
				</ul>
			</section>
		</div>
	</div>
</main>

<footer class="site-footer">
	<a href="#top" class="footer-mark">Fieldnotes <span>/ Bioscience</span></a>
	<p>Learn carefully. Question openly. Report honestly.</p>
	<a href="mailto:hello@fieldnotes.bio" class="contact-link">hello@fieldnotes.bio</a>
	<a href="#top" class="back-top">Back to top ↑</a>
</footer>

